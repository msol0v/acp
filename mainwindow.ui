}

QFrame#workArea_5 QLabel{
    color: #e6d6a8;              /* чуть ярче текст */
    font-size: 19px;
    font-weight: bold;
}

QPushButton {
    background-color: #20262b;   /* светлее кнопки */
    color: #e0e0e0;
    border: 2px solid #0a0c0f;
    border-radius: 9px;
    font-size: 22px;
    font-weight: bold;
}

QPushButton:pressed {
    background-color: #0d1013;
    padding-top: 2px;
}

QPushButton:checked {
    background-color: #3a454d;
    color: #ffffff;
    border: 2px solid #e6d6a8;
}

QDial {
    background-color: #101417;   /* раньше был почти чёрный */
    border: 3px solid #2a3238;
    border-radius: 40px;
}

QFrame#workArea,
QFrame#workArea_2,
QFrame#workArea_3,
QFrame#workArea_4,
QFrame#workArea_5
 {
    background-color: #232a30;   /* раньше слишком тёмный */
